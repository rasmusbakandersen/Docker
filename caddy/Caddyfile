(security_headers) {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}

(logging) {
    log {
        output file /var/log/caddy/{args[0]}.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

